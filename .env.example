# Copiar a .env y cambiar los valores. .env no se versiona.

# Postgres (docker compose)
POSTGRES_PASSWORD=cambia-esto
DB_PORT=5440

# API
API_PORT=8088
# Para dotnet run (localhost + DB_PORT). En compose se arma con Host=db.
ConnectionStrings__Rankeo=Host=localhost;Port=5440;Database=rankeo;Username=rankeo;Password=cambia-esto
# Orígenes del frontend separados por comas
CORS_ORIGINS=http://localhost:5173
IMAGENES_DIR=/data/imagenes
IMAGEN_MAX_KB=512
